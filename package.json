{
  "name": "cookbook-router-docs-v2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "serve out",
    "typecheck": "next typegen && fumadocs-mdx && tsc --noEmit --incremental false",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "favicon": "node scripts/create-favicon.mjs",
    "search:sync": "node scripts/sync-content.mjs",
    "generate:api-manifest": "node scripts/generate-public-api-manifest.mjs",
    "audit:api-source": "node scripts/audit-public-api-source.mjs",
    "validate:api": "node scripts/validate-api-coverage.mjs",
    "validate:imports": "node scripts/validate-code-imports.mjs",
    "validate:content": "node scripts/validate-content-structure.mjs",
    "docs:check": "pnpm validate:content && pnpm validate:api && pnpm validate:imports && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "algoliasearch": "^5.25.0",
    "fumadocs-core": "16.10.0",
    "fumadocs-docgen": "^3.0.10",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "oxc-transform": "^0.137.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
